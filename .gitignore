# ---------------------------------------------------------------------------
# Build outputs that are *not* shipped
# ---------------------------------------------------------------------------
# The shipped bundle is `plugins/kepler.gl/vendor/kepler-viewer.js`, and it is
# committed on purpose: the plugin runs from a cache directory that has no
# node_modules and no network, so a map has to render from the checkout alone.
# The copies under `viewer/test/` are the same bytes with `test/` in front, one
# minified and one not, and they exist only so a browser can load them over
# http. 42 MB of duplicates in git buys nothing.
viewer/test/kepler-viewer.js
viewer/test/kepler-viewer.debug.js

# The save handler in `serve.py` writes the config the viewer POSTs, so the
# round trip can be inspected. A fixture output, not a fixture.
viewer/test/last-save.json

# esbuild experiments. `viewer/.probe/` is where a one-off script goes to
# answer "what does esbuild actually emit for this import", which is the
# question that cost the most time on this bundle.
viewer/.probe/

node_modules/
dist/
build/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------
# Nothing here is a placeholder. `token.json` is a live Auth0 access token
# written with mode 0600 by the plugin's sign-in flow, and `dev-token.env` is
# the local-development shortcut for the same thing. Neither may ever be
# committed, and a `.env` in this repo holds the client secret.
.env
.env.*
!.env.example
dev-token.env
token.json
*.token
auth.json

# The plugin records where it was checked out so its launcher can find the
# Python package. That path is this machine's, not the project's.
plugin-root

# ---------------------------------------------------------------------------
# Editors, OS
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# `.claude/settings.local.json` holds this machine's permission grants, which
# name absolute paths and are not project policy. `.claude/launch.json` is
# shared: it is how the viewer's test server starts for anyone.
.claude/settings.local.json
